# Serena MCP server image with Go toolchain for gopls support.
#
# The base ghcr.io/oraios/serena:latest image does not include Go, which is
# required by Serena's gopls language-server integration. This Dockerfile
# copies the Go toolchain from the same golang image used by the project's
# build targets so the versions stay aligned.

FROM golang:1.26.2-trixie AS go-toolchain

FROM ghcr.io/oraios/serena:latest

COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

# Install gopls (Serena's Go language server) and add it to PATH.
RUN go install golang.org/x/tools/gopls@latest
ENV PATH="/root/go/bin:${PATH}"
